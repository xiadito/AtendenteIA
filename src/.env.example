# ==========================================================================
# .env.example — copie para .env e preencha com valores reais.
# NUNCA faça commit do .env real (contém segredos).
# Todas as variáveis são lidas em src/config.py via python-dotenv.
# ==========================================================================

# --- Database -------------------------------------------------------------
# URL de conexão Postgres. Formato: postgresql://user:senha@host:porta/banco
DATABASE_URL="postgresql://corujai_app:senha@localhost:5432/corujai"

# --- WhatsApp (Meta Cloud API — transição futura, hoje inativo) -----------
WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="000000000000000"
# Token de verificação do webhook Meta (GET /webhook)
VERIFY_TOKEN="corujaiBot"

# --- Flask ----------------------------------------------------------------
# Segredo de sessão (obrigatório para a auth do dashboard). Use um valor longo e aleatório.
FLASK_SECRET_KEY="troque-por-um-valor-aleatorio-longo"
FLASK_ENV="development"

# --- Twilio (WhatsApp Sandbox — dev/testes) -------------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_SANDBOX_NUMBER="whatsapp:+14155238886"
# Código de recuperação da conta Twilio (guardado aqui por conveniência; não é lido pelo app)
RECOVERY_CODE_TWILIO="XXXXXXXXXXXXXXXXXXXXXXXX"

# --- AI Service (Claude em dev e em produção) ------------------------------
# O Ollama foi abandonado: dev e prod usam o endpoint compatível da Anthropic.
# Trocar de provedor é só mudar estas três variáveis — não há mudança de código.
AI_BASE_URL="https://api.anthropic.com/v1/"
AI_MODEL="claude-haiku-4-5-20251001"
AI_API_KEY="sk-ant-apiXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Dashboard ------------------------------------------------------------
# DASHBOARD_USER PRECISA SER UM E-MAIL: desde o Módulo S3a ele é o identificador
# de login. Um valor sem "@" faz o bootstrap recusar (com aviso impresso no boot)
# e você fica sem conseguir entrar num banco novo.
#
# Estas duas variáveis são usadas UMA ÚNICA VEZ, para criar o primeiro usuário
# quando a tabela `users` está vazia. Depois disso o login valida contra
# users.password_hash e elas não são mais consultadas — DASHBOARD_PASSWORD é
# semente inicial, não credencial. Troque a senha logo no primeiro acesso:
#   python -m accounts.provision reset-password --email voce@exemplo.com --password -
# A senha precisa ter pelo menos 8 caracteres.
DASHBOARD_USER="voce@exemplo.com"
DASHBOARD_PASSWORD="troque-esta-senha"

# Cadastro público (Módulo S3c). Liga a tela /dashboard/signup, onde o dono de
# uma academia cria a própria conta. LIGADO POR PADRÃO desde o Módulo S3b.
#
# Ele nasceu desligado, e o padrão era a proteção: um cadastro aberto não
# arrisca criar um segundo tenant, ele FABRICA segundos tenants, e até o S3b as
# leituras não filtravam por tenant. O S3b fechou isso (`sessions` é chaveada
# por (tenant_id, sender) e toda leitura do núcleo filtra), então a trava não
# tinha mais o que proteger.
#
# O que a flag NÃO faz: a academia que se cadastra não recebe mensagem nenhuma
# enquanto o Twilio Sender dela não for aprovado à mão e o `whatsapp_number` não
# for gravado (python -m accounts.provision set-whatsapp-number). É a última
# linha, sem botão, do /dashboard/onboarding.
#
# Para fechar a porta num ambiente específico, diga explicitamente "false".
SIGNUP_ENABLED="true"

# --- Google Calendar OAuth 2.0 (Módulo 1 — onboarding) --------------------
# Credenciais tipo "Aplicativo da Web" geradas no Google Cloud Console.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"
# Deve ser IDÊNTICO (caractere a caractere) ao URI cadastrado no Google Cloud Console.
# Atenção: localhost e 127.0.0.1 são tratados como URIs DIFERENTES pelo Google.
GOOGLE_REDIRECT_URI="http://localhost:5000/integrations/google/callback"
